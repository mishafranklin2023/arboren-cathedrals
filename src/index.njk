{% extends "layouts/base.njk" %}

{% block title %}Arboren Cathedrals | Custom Catio Bridges &amp; Builds, Portland OR{% endblock %}
{% block description %}Custom catio design and build services in Portland, Oregon. Bespoke catios, skybridges, and enclosed outdoor spaces for your cats.{% endblock %}

{% block main %}
<main>

  <!-- FEATURED PHOTO -->
  <section id="featured-photo" class="featured-photo">
    <img src="images/header-pawthorne-proc-crop.webp"
      alt="Pawthorne Bridge during install" width="1280" height="591"
      fetchpriority="high" decoding="async">
  </section>

  <!-- HERO -->
  <section id="home" class="hero">
    <div class="hero-text">
      <h1>Welcome to Arboren Cathedrals</h1>
      <h2>Makers of bespoke catios and skybridges</h2>
      <p class="lede">Whether it's an elevated walkway, a climbable tower, or
