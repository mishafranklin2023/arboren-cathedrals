      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="#gallery">View Gallery</a>
        <a class="btn btn-secondary" href="contact.html">Contact Thom</a>
      </div>
    </div>
    <div class="hero-art">
      <figure class="catstruction-figure">
        <img class="hero-blueprint-img" src="images/catstruction-color-opt.png"
          alt="Cat wearing a hard hat on a Catstruction Ahead sign">
        <figcaption class="catstruction-caption">Build Plans Coming Soon!</figcaption>
      </figure>
    </div>
  </section>

  {% include "components/parts-of-catio.njk" %}

  {% include "components/gallery.njk" %}

