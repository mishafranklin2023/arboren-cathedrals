---
activePage: contact
permalink: contact.html
---
{% extends "layouts/base.njk" %}

{% block title %}Contact | Arboren CAThedrals{% endblock %}
{% block description %}Get in touch with Arboren CAThedrals for a custom catio or skybridge consultation in Portland, Oregon.{% endblock %}

{% block main %}
<main>

  <section id="contact" class="contact surface-light">
    <div class="contact-content">
      <h2>Let's build something your cat will brag about</h2>
      <p class="section-sub">Tell Thom about your space, your cats, and your bridge-pun ideas.</p>
      <form id="contactForm" class="contact-form" aria-describedby="formStatus">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" required autocomplete="name">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required autocomplete="email">
        <label for="message">Tell us about your cats &amp; your space</label>
        <textarea id="message" name="message" rows="5" required></textarea>
        <button type="submit" class="btn btn-primary">Send to Thom</button>
        <div id="formStatus" class="form-status" role="status" aria-live="polite" aria-atomic="true"></div>
      </form>
    </div>
  </section>

</main>
{% endblock %}
