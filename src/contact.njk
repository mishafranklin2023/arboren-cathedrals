---
activePage: contact
permalink: contact.html
---
{% extends "layouts/base.njk" %}

{% block title %}Contact | Arboren CAThedrals{% endblock %}
{% block description %}Get in touch with Arboren CAThedrals for a custom catio or skybridge consultation in Portland, Oregon.{% endblock %}

{% block main %}
<main>

  <section id="contact" class="contact surface-light">
    <div class="contact-content">
      <h2>Let's build something your cat will brag about</h2>
      <p class="section-sub">Tell Thom about your space, your cats, and your bridge-pun ideas.</p>
      <form id="contactForm" class="contact-form surface-dark" aria-describedby="formStatus">
        <div class="form-field">
          <label for="name">Name <span aria-hidden="true">*</span></label>
          <input type="text" id="name" name="name" required autocomplete="name" placeholder="e.g., Cathy Atio Lover">
        </div>

        <div class="form-field">
          <label for="email">Email <span aria-hidden="true">*</span></label>
          <input type="email" id="email" name="email" required autocomplete="email" placeholder="e.g., catio_lover@gmail.com">
        </div>

        <div class="form-field">
          <label for="phone">Phone <span aria-hidden="true">*</span></label>
          <input type="tel" id="phone" name="phone" required autocomplete="tel" placeholder="e.g., ###-###-####" pattern="^\d{3}-\d{3}-\d{4}$" title="Phone number must be in the format ###-###-####">
        </div>

        <fieldset class="form-group checkbox-group checkbox-row">
          <legend>Best way to contact you <span aria-hidden="true">*</span></legend>
          <label><input type="checkbox" name="contact_method[]" value="text"> Text</label>
          <label><input type="checkbox" name="contact_method[]" value="phone"> Phone</label>
          <label><input type="checkbox" name="contact_method[]" value="email"> Email</label>
        </fieldset>

        <fieldset class="form-group checkbox-group checkbox-row">
          <legend>Best time to contact you <span aria-hidden="true">*</span></legend>
          <label><input type="checkbox" name="best_time[]" value="mornings"> Mornings</label>
          <label><input type="checkbox" name="best_time[]" value="afternoons"> Afternoons</label>
          <label><input type="checkbox" name="best_time[]" value="evenings"> Evenings</label>
        </fieldset>

        <div class="form-field">
          <label for="zipcode">Zipcode <span aria-hidden="true">*</span></label>
          <input type="text" id="zipcode" name="zipcode" required autocomplete="postal-code" placeholder="e.g., 97223" pattern="^\d{5}(-\d{4})?$" title="Enter a 5-digit ZIP code">
        </div>

        <fieldset class="form-group checkbox-group">
          <legend>What services are you interested in? <span aria-hidden="true">*</span> <span class="hint">(Check all that apply)</span></legend>
          <label><input type="checkbox" name="services[]" value="arboren_cathedrals_catios"> Arboren Cathedrals Catios!</label>
          <label><input type="checkbox" name="services[]" value="diy_catio_plans"> Purchasing plans for a DIY Catio</label>
          <label><input type="checkbox" name="services[]" value="other_services" id="servicesOther"> Other Services</label>
          <div id="otherServicesOptions" class="conditional-group">
            <p class="hint">Select any that apply:</p>
            <label><input type="checkbox" name="services[]" value="laser_cutting"> Laser cutting</label>
            <label><input type="checkbox" name="services[]" value="engraving"> Engraving</label>
            <label><input type="checkbox" name="services[]" value="3d_design_printing"> 3D design / printing</label>
          </div>
          <label><input type="checkbox" name="services[]" value="just_talk"> I'm not planning a project, but I'd like to talk to you.</label>
        </fieldset>

        <fieldset class="form-group radio-group">
          <legend>Where are you in the planning process? <span aria-hidden="true">*</span></legend>
          <label><input type="radio" name="planning_process" value="inspired_curious" required> I'm inspired and curious, let's discuss options.</label>
          <label><input type="radio" name="planning_process" value="turn_ideas"> Help turn my ideas into a project.</label>
          <label><input type="radio" name="planning_process" value="finalizing_plan"> I'm finalizing my plan and prepping the catio location.</label>
          <label><input type="radio" name="planning_process" value="ready_to_go"> I'm ready to go with plans and a prepped site.</label>
        </fieldset>

        <div class="form-field">
          <label for="message">Add your comments, questions, or describe your project <span aria-hidden="true">*</span></label>
          <textarea id="message" name="message" rows="5" required placeholder="e.g., Tell us about your cats & your space (~1000 chars)"></textarea>
        </div>

        <div class="form-field">
          <label for="files">Upload any sketches / photo inspiration / plans</label>
          <input type="file" id="files" name="files" multiple accept=".pdf,.txt,.docx,.png,.webp,.avif,.jpg,.jpeg,.tiff,image/*">
          <p class="hint" id="fileHint">Accepted formats: .pdf, .txt, .docx, .png, .webp, .avif, .jpg, .jpeg, .tiff. Max 10 MB per file.</p>
        </div>

        <button type="submit" class="btn btn-primary">Send to Thom</button>
        <div id="formStatus" class="form-status" role="status" aria-live="polite" aria-atomic="true"></div>
      </form>
    </div>
  </section>

</main>
{% endblock %}
